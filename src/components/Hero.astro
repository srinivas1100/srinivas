---
---

<section class="relative min-h-screen flex items-center pt-20 pb-16 px-6 bg-gradient-to-b from-[#0B1221] to-[#0a192f]">
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(59,130,246,0.1),transparent_50%)]"></div>
  </div>
  
  <div class="container mx-auto max-w-4xl relative z-10">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div class="hero-content">
        <div class="overflow-hidden">
          <h1 class="text-5xl md:text-6xl font-bold mb-4 hero-title opacity-0">
            Hi, I'm <span class="bg-gradient-to-r from-[#3B82F6] to-[#60A5FA] text-transparent bg-clip-text">Srinivas Vadlamudi</span>
          </h1>
        </div>
        
        <div class="overflow-hidden">
          <p class="text-[#60A5FA] text-2xl font-semibold mb-4 hero-subtitle opacity-0">
            Full Stack & Flutter Developer
          </p>
        </div>
        
        <div class="overflow-hidden">
          <p class="text-gray-400 mb-8 max-w-lg hero-description opacity-0">
            Building exceptional digital experiences with expertise in Flutter, MERN stack development, and integrating cutting-edge LLMs and OpenAI technologies.
          </p>
        </div>
        
        <div class="flex gap-4 hero-buttons opacity-0">
          <a href="#projects" class="px-6 py-3 bg-[#3B82F6] text-white rounded-md hover:scale-105 hover:shadow-[0_0_20px_rgba(59,130,246,0.5)] transition-all duration-300">
            View Projects
          </a>
          <a href="#contact" class="px-6 py-3 border border-[#3B82F6] text-[#3B82F6] rounded-md hover:bg-[#3B82F6]/10 hover:scale-105 hover:shadow-[0_0_20px_rgba(59,130,246,0.3)] transition-all duration-300">
            Contact Me
          </a>
        </div>
      </div>
      <div class="relative hidden md:block hero-image opacity-0">
        <div class="w-full h-[400px] rounded-full bg-gradient-to-r from-[#3B82F6] to-[#60A5FA] opacity-20 blur-3xl absolute -top-10 -right-10"></div>
        <div class="relative">
          <img 
            src="https://raw.githubusercontent.com/srinivas1100/cv/refs/heads/main/Leonardo_Anime_XL_A_futuristic_cyberpunk_animestyle_portrait_o_1.jpg" 
            alt="Profile" 
            class="w-[400px] h-[400px] object-cover rounded-lg shadow-2xl"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-[#3B82F6]/20 to-transparent mix-blend-overlay rounded-lg"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#0B1221] opacity-50 rounded-lg"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-title,
  .hero-subtitle,
  .hero-description {
    clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    transform: translateY(20px);
  }

  .hero-buttons {
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-image {
    opacity: 0;
    transform: translateX(50px);
  }
</style>

<script>
  import gsap from 'gsap';
  
  window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    
    tl.to(".hero-title", {
      opacity: 1,
      y: 0,
      duration: 1,
      clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)"
    })
    .to(".hero-subtitle", {
      opacity: 1,
      y: 0,
      duration: 1,
      clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)"
    }, "-=0.8")
    .to(".hero-description", {
      opacity: 1,
      y: 0,
      duration: 1,
      clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)"
    }, "-=0.8")
    .to(".hero-buttons", {
      opacity: 1,
      y: 0,
      duration: 1
    }, "-=0.6")
    .to(".hero-image", {
      opacity: 1,
      x: 0,
      duration: 1.2,
      ease: "power4.out"
    }, "-=1");
  });
</script>