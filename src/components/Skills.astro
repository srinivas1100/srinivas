---
import skillsData from "../data/skills.json";
---

<section id="skills" class="py-20 px-6 bg-[#0a192f] relative">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(59,130,246,0.05),transparent_70%)]"
  >
  </div>

  <div class="container mx-auto max-w-7xl relative z-10">
    <div class="flex flex-col items-center mb-16" data-aos="fade-up">
      <div
        class="px-8 py-4 rounded-xl bg-gray-800/50 border-2 border-[#3B82F6]/50 text-[#3B82F6] text-4xl font-extrabold tracking-wide shadow-lg backdrop-blur-sm"
      >
        MY SKILLS
      </div>
      <div class="h-16 w-px bg-[#3B82F6]/50"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        skillsData.map((category) => (
          <div class="flex flex-col items-center w-full" data-aos="fade-up">
            <div class="px-6 py-4 rounded-lg bg-gray-800/50 border border-[#3B82F6]/50 text-[#3B82F6] font-bold text-xl text-center w-full shadow-lg backdrop-blur-sm">
              {category.title}
            </div>
            <div class="h-8 w-px bg-[#3B82F6]/50 my-4" />

            <div class="space-y-4 w-full">
              {category.skills.map((skill) => (
                <a
                  href={`/skills/${skill.name.toLowerCase()}`}
                  class="group relative cursor-pointer"
                >
                  <div class="p-3 rounded-md bg-gray-800/50 border border-[#3B82F6]/30 hover:border-[#3B82F6] text-gray-300 hover:text-[#3B82F6] flex flex-col items-center gap-2 transition-all duration-300 backdrop-blur-sm hover:bg-gray-800/70 group-hover:max-h-96 group-hover:py-4 overflow-hidden max-h-24 mb-4">
                    <img
                      src={skill.icon}
                      alt={skill.name}
                      class={`skill-icon ${skill.color} transition-transform duration-300 group-hover:scale-110`}
                      width="24"
                      height="24"
                    />
                    <span class="font-medium text-center text-lg">
                      {skill.name}
                    </span>
                    {skill.details && (
                      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-sm text-gray-300 mt-4">
                        {skill.details}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
