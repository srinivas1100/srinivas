---
// ExpertiseSection.astro

// First, create a separate React component for the 3D icon
const ThreeIcon = {
  name: 'ThreeIcon',
  render(props) {
    return `<div id="icon-${props.iconType}" class="w-24 h-24 mx-auto mb-4"></div>`;
  }
};

interface ExpertiseItem {
  title: string;
  description: string;
  iconType: 'mobile' | 'web' | 'ai';
}

const expertise: ExpertiseItem[] = [
  {
    title: "Mobile Development",
    description: "Expert in building cross-platform mobile applications with Flutter and Dart, including integration of Firebase, Agora SDK, and payment gateways. Proficient in native iOS development with Swift.",
    iconType: "mobile"
  },
  {
    title: "Full Stack Development",
    description: "Full-stack development using MongoDB, Express.js, React, and Node.js. Experienced in building scalable web applications with TypeScript and modern development practices.",
    iconType: "web"
  },
  {
    title: "AI Integration",
    description: "Implementation of AI-driven features using OpenAI's GPT models and DALL·E for content generation and automation. Focus on enhancing user experience through AI technologies.",
    iconType: "ai"
  }
];

---

<script>
  import * as THREE from 'three';

  // Initialize 3D scenes after the page loads
  function initThreeScene(iconType, containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Scene setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ 
      alpha: true,
      antialias: true 
    });
    
    renderer.setSize(100, 100);
    container.appendChild(renderer.domElement);

    // Create geometry based on expertise type
    let geometry;
    let material;
    
    switch (iconType) {
      case 'mobile':
        geometry = new THREE.BoxGeometry(1, 2, 0.1);
        material = new THREE.MeshPhongMaterial({ 
          color: 0x3B82F6,
          transparent: true,
          opacity: 0.9,
          shininess: 100
        });
        break;
      case 'web':
        geometry = new THREE.TorusKnotGeometry(0.8, 0.2, 64, 16);
        material = new THREE.MeshPhongMaterial({ 
          color: 0x3B82F6,
          transparent: true,
          opacity: 0.9,
          shininess: 100
        });
        break;
      case 'ai':
        geometry = new THREE.SphereGeometry(1, 32, 32);
        material = new THREE.MeshPhongMaterial({ 
          color: 0x3B82F6,
          transparent: true,
          opacity: 0.9,
          shininess: 100
        });
        break;
    }

    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    // Add lights
    const light = new THREE.DirectionalLight(0xffffff, 1);
    light.position.set(1, 1, 1);
    scene.add(light);

    const ambientLight = new THREE.AmbientLight(0x404040);
    scene.add(ambientLight);

    camera.position.z = 5;

    // Animation
    function animate() {
      requestAnimationFrame(animate);
      
      // Custom animations based on icon type
      switch (iconType) {
        case 'mobile':
          mesh.rotation.y += 0.01;
          mesh.rotation.x = Math.sin(Date.now() * 0.001) * 0.2;
          break;
        case 'web':
          mesh.rotation.x += 0.01;
          mesh.rotation.y += 0.01;
          break;
        case 'ai':
          mesh.rotation.y += 0.01;
          mesh.scale.x = mesh.scale.y = mesh.scale.z = 
            1 + Math.sin(Date.now() * 0.002) * 0.1;
          break;
      }
      
      renderer.render(scene, camera);
    }

    animate();
  }

  // Initialize all icons when the page loads
  document.addEventListener('DOMContentLoaded', () => {
    const icons = ['mobile', 'web', 'ai'];
    icons.forEach(iconType => {
      initThreeScene(iconType, `icon-${iconType}`);
    });
  });
</script>

<section id="expertise" class="relative min-h-screen flex items-center pt-20 pb-16 px-6 bg-gradient-to-b from-[#0B1221] to-[#0a192f]" data-aos="fade-up">
    <!-- Radial Gradient Background -->
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(59,130,246,0.1),_transparent_50%)]" 
             data-aos="fade-in" 
             data-aos-duration="1000">
        </div>
    </div>

    <div class="container mx-auto max-w-5xl relative z-10">
        <!-- Section Title -->
        <h2 class="text-5xl font-bold text-center mb-12 text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-blue-400" 
            data-aos="fade-down" 
            data-aos-duration="1200">
            Expertise
        </h2>

        <!-- Expertise Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" 
             data-aos="fade-up" 
             data-aos-duration="1200">
            {expertise.map((item, index) => (
                <div class="relative bg-[#0B1221] rounded-lg p-6 border border-blue-500/50 
                            transition-all duration-300 shadow-lg hover:border-blue-400 
                            hover:scale-105 hover:shadow-xl hover:bg-[#0d1a34] transform-gpu
                            group cursor-pointer"
                     data-aos="zoom-in" 
                     data-aos-delay={index * 200} 
                     data-aos-duration="1000">
                    
                    <!-- 3D Icon Container -->
                    <div class="transform transition-transform duration-500 group-hover:scale-110">
                        <div id={`icon-${item.iconType}`} class="w-24 h-24 mx-auto mb-4"></div>
                    </div>

                    <!-- Card Content -->
                    <h3 class="text-2xl font-bold mb-2 text-transparent bg-clip-text 
                               bg-gradient-to-r from-blue-500 to-blue-400">
                        {item.title}
                    </h3>
                    <p class="text-gray-300">
                        {item.description}
                    </p>

                    <!-- Hover Glow Effect -->
                    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-blue-600/0 
                                via-blue-600/10 to-blue-600/0 opacity-0 group-hover:opacity-100 
                                transition-opacity duration-500 rounded-lg">
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>