<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('.submit-btn');
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const recipientEmail = 'srinu11112000@gmail.com'; // Your email address
  
  const showMessage = (element, duration = 5000) => {
    element?.classList.remove('hidden');
    element?.classList.add('visible');
    setTimeout(() => {
      element?.classList.remove('visible');
      element?.classList.add('hidden');
    }, duration);
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (!submitBtn) return;
    
    // Add loading state
    submitBtn.classList.add('loading');
    (submitBtn as HTMLButtonElement).disabled = true;

    try {
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;

      const name = nameInput.value;
      const email = emailInput.value;
      const message = messageInput.value;

      // Create subject with name
      const subject = `Message from ${name} via Portfolio Contact Form`;
      
      // Create email body with formatted message
      const body = `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`;
      
      // Generate mailto link with all parameters
      const mailtoLink = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      
      // Open the mail client with the prepared email
      window.location.href = mailtoLink;
      
      showMessage(successMessage);
      
      // Reset the form after a delay to give time for mail client to open
      setTimeout(() => {
        form.reset();
      }, 1000);
    } catch (error) {
      console.error('Failed to open mail client:', error);
      showMessage(errorMessage);
    } finally {
      submitBtn.classList.remove('loading');
      (submitBtn as HTMLButtonElement).disabled = false;
    }
  });
</script>