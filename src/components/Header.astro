---
const navItems = [
  { name: 'About', href: '#about' },
  { name: 'Expertise', href: '#expertise' },
  { name: 'Skills', href: '#skills' },
  { name: 'Projects', href: '#projects' },
  { name: 'Experience', href: '#experience' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="fixed w-full bg-gray-900/80 backdrop-blur-sm border-b border-gray-800 z-50">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <a class="text-2xl font-bold bg-gradient-to-r from-blue-500 to-purple-500 text-transparent bg-clip-text">
        Full Stack & Flutter Developer
      </a>
      <div class="hidden md:flex space-x-8">
        {navItems.map(item => (
          <a href={item.href} class="nav-link">
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
    color: #cbd5e1;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.3s ease-in-out;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px; /* Adjust distance of the line from text */
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #3B82F6, #A855F7); /* Matching gradient */
    transition: width 0.4s ease-in-out;
  }

  .nav-link:hover {
    color: #3B82F6;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>