---
import skillsData from '../../data/skills.json';

export function getStaticPaths() {

  const skills = skillsData.map((e) => e.skills).flat()

  return skills.map((e) => ({
     params: { slug: e.name.toLowerCase() },
     props: e
  }));
}

const data = Astro.props;
---


<html>
  <head>
    <title>{data.name} Skills</title>
  </head>
  <body class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 text-white">
    <div class="container mx-auto p-6">
      <header class="header flex items-center gap-4 bg-gradient-to-r from-blue-500 to-blue-700 p-6 rounded-lg shadow-lg">
        <img src={data.icon} alt="{data.name} Icon" class="w-16">
        <h1 class="text-3xl font-bold">{data.name} Development</h1>
      </header>
      
      <section class="section bg-gray-800 p-6 rounded-lg shadow-lg mt-6">
        <h2 class="text-xl text-blue-400">Overview</h2>
        <p>{data.details}</p>
      </section>
      
      {data.longDescription && data.longDescription.map((category) => (
        <section class="section bg-gray-800 p-6 rounded-lg shadow-lg mt-6">
          <h2 class="text-xl text-blue-400">{category.title}</h2>
          <ul class="list-none">
            {category.points.map((point) => (
              <li class="pl-6 relative before:absolute before:left-0 before:content-['✔'] before:text-blue-400">
                {point}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
   
  </body>
</html>
