---

import skillsData from '../data/skills.json';

// Extract the `slug` from the URL (e.g., "/skills/react" => slug = "react")
const { slug } = Astro.params;

// Flatten all skills into a single array
const allSkills = skillsData.flatMap((category) => category.skills);

// Find the matching skill by comparing the slug with the skill's name
const skill = allSkills.find(
  (item) => item.name.toLowerCase() === slug?.toLowerCase()
);

// If no skill is found, you can choose to throw, redirect, or show a 404
if (!skill) {
  return Astro.redirect('/404'); // or throw new Error('Skill not found');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{skill.name} - My Skills</title>
    <!-- Meta tags, SEO, etc. -->
  </head>
  <body class="bg-[#0a192f] text-white">
    <!-- Main Section -->
    <section class="min-h-screen py-20 px-6 relative">
      <!-- Radial Gradient Background -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(59,130,246,0.05),transparent_70%)]"></div>

      <div class="container mx-auto max-w-5xl relative z-10">
        <!-- Title -->
        <div class="text-center mb-12">
          <h1 class="text-4xl font-extrabold tracking-wider text-[#3B82F6]">
            {skill.name}
          </h1>
          <div class="h-16 w-px bg-[#3B82F6]/50 mx-auto mt-4"></div>
        </div>

        <!-- Content Box -->
        <div class="bg-gray-800/50 border border-[#3B82F6]/50 p-8 rounded-xl shadow-lg backdrop-blur-sm">
          <!-- Icon & Basic Info -->
          <div class="flex flex-col items-center mb-8">
            <img
              src={skill.icon}
              alt={skill.name}
              width="48"
              height="48"
              class={skill.color + " transition-transform duration-300 hover:scale-110 mb-4"}
            />
            <h2 class="text-2xl font-bold text-gray-200">{skill.name}</h2>
          </div>

          <!-- Long Description -->
          <p class="text-gray-300 leading-relaxed mb-4">
            {skill.longDescription || skill.details}
          </p>
        </div>
      </div>
    </section>
  </body>
</html>